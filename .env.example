# Frontend: copy these VITE_* values to frontend/.env.local.
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend: copy backend values to the repository-root .env.
DATABASE_URL=
FIREBASE_PROJECT_ID=
# Path to a Firebase service account JSON file kept outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
FRONTEND_ORIGIN=http://localhost:5173
